# =============================================================================
# WAS DU VON IONOS BRAUCHST (alles zum GLEICHEN Mailpostfach!)
# =============================================================================
# 1) Volle E-Mail-Adresse des Postfachs  →  IONOS_SMTP_USER und IONOS_IMAP_USER
#    (z. B. partners@deine-domain.de — genau die Adresse, die du im Webmail nutzt.)
# 2) Passwort DIESES Postfachs  →  IONOS_SMTP_PASS und IONOS_IMAP_PASS
#    (In IONOS: E-Mail & Office → Zugangsdaten / Postfachpasswort.
#     Das ist oft NICHT dasselbe wie dein IONOS-Kundenkonto-Login — es muss zum
#     Postfach passen, mit dem du Mails senden willst.)
# 3) Wenn IMAP-Passwort separat: trage es bei IONOS_IMAP_PASS ein; sonst reicht
#    oft dieselbe Zeichenkette wie bei SMTP (bei IONOS meist identisch).
#
# OHNE diese vier Werte: kein Erstmail-Versand (SMTP), kein IMAP (Entwürfe, Lesen).
# =============================================================================

# Kopie: .env.example -> .env (im gleichen Ordner wie mine.py)
# Platzhalter ersetzen, .env niemals committen.

IONOS_SMTP_HOST=smtp.ionos.de
IONOS_SMTP_PORT=587
IONOS_SMTP_USER=dein@ionos.de
IONOS_SMTP_PASS=REPLACE_ME_IONOS_PASSWORT

IONOS_IMAP_HOST=imap.ionos.de
IONOS_IMAP_PORT=993
IONOS_IMAP_USER=dein@ionos.de
IONOS_IMAP_PASS=REPLACE_ME_IONOS_PASSWORT

# Nach Versand Kopie in Server-Ordner „Gesendet“ (1=an, 0=aus)
IONOS_SYNC_SENT=1
# Nur noetig, wenn Auto-Erkennung scheitert: exakter IMAP-Ordnername (Webmail pruefen)
# IONOS_SENT_FOLDER=Gesendet

# Optional: sichtbarer Absender (sonst nutzt send_email IONOS_SMTP_USER)
# MAIL_FROM=Dein Name <dein@ionos.de>
# MAIL_REPLY_TO=dein@ionos.de

# Optional: wenn send_email aus anderem Verzeichnis startet
# DOTENV_PATH=C:\Users\...\b2bbot\.env

REPLY_AUTO_SEND_ROUTES=template,small_llm
# Reply-Vorschlag: review (Default). true nur wenn echte Auto-Versand-Freigabe (positive/neutral → send).
REPLY_AUTO_SEND=false
# Optional: IMAP-Ordnername fuer Entwuerfe (sonst Drafts / Entwuerfe automatisch)
# IONOS_DRAFTS_FOLDER=Entwürfe
REPLY_DRY_RUN=0

OPENAI_API_KEY=REPLACE_ME_OPENAI_API_KEY
OPENAI_REPLY_SMALL_MODEL=gpt-4o-mini
OPENAI_REPLY_LARGE_MODEL=gpt-4o

# Optional
# FOLLOWUP_DAYS_1=3
# FOLLOWUP_DAYS_2=7
# SEND_EMAIL_SCRIPT=

# =============================================================================
# CRM Push — Pipedrive (ALLE DREI müssen gesetzt sein für echten Push)
# =============================================================================
# Ohne CRM_PUSH_CONFIRMED=1  → immer Dry-Run, kein API-Call
# Ohne PIPEDRIVE_API_TOKEN   → immer Dry-Run
# Ohne CRM_PROVIDER=pipedrive → immer Dry-Run
#
# Token holen: Pipedrive → Einstellungen → Persönliche Einstellungen → API
# =============================================================================
# CRM_PROVIDER=pipedrive
# PIPEDRIVE_API_TOKEN=REPLACE_ME_PIPEDRIVE_TOKEN
# CRM_PUSH_CONFIRMED=1
